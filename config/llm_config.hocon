{
    # Shared LLM configuration for every agent network that includes this file.
    # Change the model here and every network picks it up.
    #
    # Google AI Studio (Gemini API). Requires GOOGLE_API_KEY in .env - get one at
    # https://aistudio.google.com/apikey
    #
    # Other Gemini models available out of the box:
    #   "gemini-3.5-flash-lite"  cheaper and faster, fine for simple networks
    #   "gemini-3.1-pro"         strongest reasoning, slower and pricier
    # The full list of supported models and per-model parameters lives in neuro-san's
    # default_llm_info.hocon.
    "llm_config": {
        "model_name": "gemini-3.5-flash",

        # Gemini 3.0+ wants temperature at 1.0. Google's own guidance is that lowering it
        # causes infinite loops, degraded reasoning and failures on complex tasks - which
        # matters here because the AAOSA networks do multi-step tool calling.
        # See https://ai.google.dev/gemini-api/docs/gemini-3#temperature
        "temperature": 1.0
    }
}
